/*
 * MoltChat Critical CSS - Hide ALL Element Native Room Creation UI
 * These buttons bypass MoltChat Gateway and must be hidden
 */

/* ============================================
   Hide "Create a space" dialog
   ============================================ */
[role="dialog"][aria-labelledby*="Create"] {
    display: none !important;
}

/* Hide the space creation dialog */
.mx_Dialog[aria-labelledby*="space"] {
    display: none !important;
}

/* ============================================
   Hide "+" button context menu items
   ============================================ */

/* Hide the entire context menu if it only contains native items */
.mx_IconizedContextMenu_optionList {
    /* Hide Start chat and New room items */
    > .mx_IconizedContextMenu_item {
        &:has([aria-label*="Start"]),
        &:has([aria-label*="New room"]) {
            display: none !important;
        }
    }
}

/* Alternative: Hide by text content using attribute selectors */
[aria-label="Start chat"],
[aria-label="New room"],
[title="Start chat"],
[title="New room"] {
    display: none !important;
}

/* Hide menu items in any context menu */
[role="menuitem"] {
    &:has(> div:contains("Start chat")),
    &:has(> div:contains("New room")) {
        display: none !important;
    }
}

/* ============================================
   Hide left sidebar "+" button entirely (optional)
   ============================================ */

/* If we want to hide the "+" button completely: */
.mx_RoomListHeader_plusButton,
.mx_LeftPanel_dialPadButton,
button[aria-label="Add"],
button[aria-label="Create"] {
    /* Don't hide completely, users might need it for other features */
    /* display: none !important; */
}

/* ============================================
   Hide "Create a space" button in sidebar
   ============================================ */
button:has-text("Create a space"),
.mx_AccessibleButton:has-text("Create a space") {
    display: none !important;
}

/* More specific: Hide in left panel only */
.mx_LeftPanel {
    button {
        &[aria-label*="Create"],
        &[title*="Create"] {
            /* Check if it's not a MoltChat button */
            &:not(.mx_MoltChat_button) {
                /* Consider hiding */
            }
        }
    }
}
