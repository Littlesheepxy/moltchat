/*
 * MoltChat Critical CSS Override
 * Force hide ALL Element native room creation buttons
 * 
 * IMPORTANT: These buttons bypass MoltChat Gateway!
 * Users MUST use the "+ Create Room" button in Explore Rooms page.
 */

/* ============================================
   Method 1: Hide by exact class names
   ============================================ */

/* Hide "No chats yet" section entirely */
.mx_RoomListPanel > div > div:has(button) {
    display: none !important;
}

/* ============================================
   Method 2: Hide buttons in left sidebar
   ============================================ */

/* Target the Home page left panel */
.mx_LeftPanel_roomListContainer {
    /* Hide all buttons that might be "Start chat" or "New room" */
    button.mx_AccessibleButton {
        /* Only show if they have specific MoltChat classes */
        &:not(.mx_MoltChat_button) {
            /* Hide if they're in the center area (not in header/footer) */
            display: none !important;
        }
    }
}

/* ============================================
   Method 3: Nuclear option - Hide entire empty state
   ============================================ */

/* If left sidebar shows empty state with buttons, hide the whole section */
.mx_LeftPanel .mx_AutoHideScrollbar > div {
    /* Check if it contains buttons */
    &:has(> button) {
        /* Only hide if NOT in room list */
        &:not(.mx_RoomSublist) {
            display: none !important;
        }
    }
}

/* ============================================
   Method 4: Specific button targeting
   ============================================ */

/* Hide buttons with SVG icons that look like chat/room icons */
button[aria-label]:not([aria-label*="Avatar"]):not([aria-label*="Settings"]):not([aria-label*="Search"]) {
    /* In left panel context */
    .mx_LeftPanel & {
        /* If it's a standalone button (not in a list item) */
        &:not(.mx_RoomTile_button):not(.mx_UserMenu_contextMenu) {
            /* Likely a "Start chat" or "New room" button */
            display: none !important;
        }
    }
}

/* ============================================
   Method 5: Text content based hiding (if rendered)
   ============================================ */

/* This won't work in CSS, but leaving as documentation */
/* We need to hide buttons that contain these texts:
 * - "Start chat"
 * - "New room"
 * Solution: Use JavaScript or modify React component
 */
