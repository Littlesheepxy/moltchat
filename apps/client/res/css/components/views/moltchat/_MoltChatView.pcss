/*
 * MoltChat Page Styles
 * Full-page views for Explore, Agents, Profile
 */

/* ============================================
   Full Page Layout
   ============================================ */

.mx_MoltChatPage {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background-color: var(--cpd-color-bg-canvas-default);
}

.mx_MoltChatPage_container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 24px;
    width: 100%;
    height: 100%;
    overflow-y: auto;

    /* 平板端 */
    @media (max-width: 768px) {
        padding: 24px 16px;
    }

    /* 移动端 */
    @media (max-width: 480px) {
        padding: 16px 12px;
    }
}

/* Header */
.mx_MoltChatPage_header {
    margin-bottom: 24px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;

    /* 移动端：改为竖向排列 */
    @media (max-width: 640px) {
        flex-direction: column;
        align-items: stretch;
    }
}

.mx_MoltChatPage_title {
    font-size: 28px;
    font-weight: 600;
    color: var(--cpd-color-text-primary);
    margin: 0 0 8px 0;

    /* 平板端 */
    @media (max-width: 768px) {
        font-size: 24px;
    }

    /* 移动端 */
    @media (max-width: 480px) {
        font-size: 20px;
    }
}

.mx_MoltChatPage_subtitle {
    font-size: 15px;
    color: var(--cpd-color-text-secondary);
    margin: 0;

    /* 移动端 */
    @media (max-width: 480px) {
        font-size: 13px;
    }
}

.mx_MoltChatPage_createButton {
    padding: 12px 24px;
    background-color: #DF3B2D;
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
    /* 固定高度 */
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;

    &:hover {
        background-color: #C42F23;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(223, 59, 45, 0.3);
    }

    /* 移动端：全宽 */
    @media (max-width: 640px) {
        width: 100%;
        justify-content: center;
    }
}

/* ============================================
   Filters & Search
   ============================================ */

.mx_MoltChatPage_filters {
    margin-bottom: 24px;
}

.mx_MoltChatPage_search {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;

    /* 移动端：改为竖向排列 */
    @media (max-width: 480px) {
        flex-direction: column;
    }
}

.mx_MoltChatPage_searchInput {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 12px;
    font-size: 14px;
    background-color: var(--cpd-color-bg-canvas-default);
    color: var(--cpd-color-text-primary);
    /* 固定高度确保一致 */
    height: 44px;
    box-sizing: border-box;

    &:focus {
        outline: none;
        border-color: #DF3B2D;
    }

    &::placeholder {
        color: var(--cpd-color-text-secondary);
    }
}

.mx_MoltChatPage_searchButton {
    padding: 12px 24px;
    background-color: #DF3B2D;
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    /* 确保和输入框高度一致 */
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;

    &:hover {
        background-color: #C42F23;
    }

    /* 移动端：全宽 */
    @media (max-width: 480px) {
        width: 100%;
    }
}

.mx_MoltChatPage_filterRow {
    display: flex;
    gap: 12px;

    /* 移动端：改为竖向排列 */
    @media (max-width: 640px) {
        flex-direction: column;
    }
}

.mx_MoltChatPage_select {
    padding: 10px 16px;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 8px;
    font-size: 14px;
    background-color: var(--cpd-color-bg-canvas-default);
    color: var(--cpd-color-text-primary);
    min-width: 150px;
    cursor: pointer;

    &:focus {
        outline: none;
        border-color: #DF3B2D;
    }

    /* 移动端：全宽 */
    @media (max-width: 640px) {
        width: 100%;
        min-width: 0;
    }
}

/* ============================================
   Actions
   ============================================ */

.mx_MoltChatPage_actions {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
}

/* ============================================
   Content Area
   ============================================ */

.mx_MoltChatPage_content {
    flex: 1;
}

/* Loading State */
.mx_MoltChatPage_loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
    color: var(--cpd-color-text-secondary);
}

.mx_MoltChatPage_spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--cpd-color-border-interactive-secondary);
    border-top-color: #DF3B2D;
    border-radius: 50%;
    animation: moltchat-spin 0.8s linear infinite;
    margin-bottom: 16px;
}

@keyframes moltchat-spin {
    to {
        transform: rotate(360deg);
    }
}

/* Empty State */
.mx_MoltChatPage_empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
    text-align: center;
}

.mx_MoltChatPage_emptyIcon {
    font-size: 64px;
    margin-bottom: 16px;
}

.mx_MoltChatPage_emptyHint {
    color: var(--cpd-color-text-secondary);
    font-size: 14px;
    margin-top: 8px;
    margin-bottom: 24px;
}

/* Error State */
.mx_MoltChatPage_error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    text-align: center;

    p {
        color: #ef4444;
        margin-bottom: 16px;
    }
}

/* ============================================
   Grid Layout (for Explore)
   ============================================ */

.mx_MoltChatPage_grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;

    /* 桌面大屏：4列 */
    @media (min-width: 1400px) {
        grid-template-columns: repeat(4, 1fr);
    }

    /* 桌面：3列 */
    @media (min-width: 1024px) and (max-width: 1399px) {
        grid-template-columns: repeat(3, 1fr);
    }

    /* 平板：2列 */
    @media (min-width: 640px) and (max-width: 1023px) {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    /* 移动端：1列 */
    @media (max-width: 639px) {
        grid-template-columns: 1fr;
        gap: 12px;
    }
}

.mx_MoltChatPage_card {
    background-color: var(--cpd-color-bg-subtle-secondary);
    border-radius: 16px;
    padding: 20px;
    cursor: pointer;
    transition: all 0.2s ease;
    /* 统一的灰色边框 */
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    /* 增加卡片高度 */
    min-height: 200px;
    display: flex;
    flex-direction: column;

    &:hover {
        background-color: var(--cpd-color-bg-subtle-primary);
        border-color: var(--cpd-color-border-interactive-primary);
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }

    /* 移动端：减少内边距 */
    @media (max-width: 480px) {
        padding: 16px;
        border-radius: 12px;
        min-height: 180px;
    }

    /* 触摸设备：禁用 hover transform */
    @media (hover: none) {
        &:hover {
            transform: none;
        }

        &:active {
            transform: scale(0.98);
        }
    }
}

.mx_MoltChatPage_cardHeader {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;

    /* 移动端：减少间距 */
    @media (max-width: 480px) {
        gap: 8px;
    }
}

.mx_MoltChatPage_cardTitle {
    font-size: 16px;
    font-weight: 600;
    color: var(--cpd-color-text-primary);
    margin: 0;
    flex: 1;
    word-break: break-word;

    /* 移动端：稍小字体 */
    @media (max-width: 480px) {
        font-size: 15px;
    }
}

.mx_MoltChatPage_cardDescription {
    font-size: 13px;
    color: var(--cpd-color-text-secondary);
    margin: 0 0 12px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
    line-height: 1.5;
    flex-grow: 1; /* 让描述占据可用空间 */

    /* 移动端：稍小字体 */
    @media (max-width: 480px) {
        font-size: 12px;
        margin-bottom: 8px;
    }
}

/* 房间创建者信息 */
.mx_MoltChatPage_cardOwner {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--cpd-color-text-secondary);
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--cpd-color-border-interactive-secondary);

    .mx_MoltChatPage_cardOwnerIcon {
        width: 14px;
        height: 14px;
        opacity: 0.7;
    }

    .mx_MoltChatPage_cardOwnerName {
        font-weight: 500;
        color: var(--cpd-color-text-primary);
    }
}

/* 房间标签 */
.mx_MoltChatPage_cardTags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
}

.mx_MoltChatPage_cardTag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 500;
    /* 默认 General 样式 */
    background-color: rgba(156, 163, 175, 0.15);
    color: #9CA3AF;

    .mx_MoltChatPage_tagIcon {
        width: 12px;
        height: 12px;
    }

    /* Philosophy - 红色 */
    &.tag-philosophy {
        background-color: rgba(223, 59, 45, 0.15);
        color: #DF3B2D;
    }

    /* Tech - 蓝色 */
    &.tag-tech {
        background-color: rgba(59, 130, 246, 0.15);
        color: #3B82F6;
    }

    /* Creative - 紫色 */
    &.tag-creative {
        background-color: rgba(139, 92, 246, 0.15);
        color: #8B5CF6;
    }

    /* Science - 绿色 */
    &.tag-science {
        background-color: rgba(16, 185, 129, 0.15);
        color: #10B981;
    }

    /* Gaming - 橙色 */
    &.tag-game {
        background-color: rgba(245, 158, 11, 0.15);
        color: #F59E0B;
    }

    /* Business - 粉色 */
    &.tag-business {
        background-color: rgba(236, 72, 153, 0.15);
        color: #EC4899;
    }

    /* General - 灰色 */
    &.tag-general {
        background-color: rgba(156, 163, 175, 0.15);
        color: #9CA3AF;
    }
}

.mx_MoltChatPage_cardFooter {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: auto; /* 推到底部 */
    padding-top: 12px;
    border-top: 1px solid var(--cpd-color-border-interactive-secondary);

    /* 移动端：减少间距 */
    @media (max-width: 480px) {
        gap: 12px;
    }
}

.mx_MoltChatPage_cardMeta {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: var(--cpd-color-text-secondary);

    /* SVG 图标样式 */
    svg {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
    }

    /* 移动端：稍小字体 */
    @media (max-width: 480px) {
        font-size: 11px;
        
        svg {
            width: 12px;
            height: 12px;
        }
    }
}

/* ============================================
   List Layout (for Agents)
   ============================================ */

.mx_MoltChatPage_list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.mx_MoltChatPage_listItem {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background-color: var(--cpd-color-bg-subtle-secondary);
    border-radius: 12px;
    transition: background-color 0.15s ease;

    &:hover {
        background-color: var(--cpd-color-bg-subtle-primary);
    }
}

.mx_MoltChatPage_listItemIcon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
}

.mx_MoltChatPage_statusDot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--cpd-color-icon-secondary);

    &.online {
        background-color: #DF3B2D;
        box-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
    }

    &.offline {
        background-color: var(--cpd-color-icon-secondary);
    }
}

.mx_MoltChatPage_listItemContent {
    flex: 1;
    min-width: 0;
}

.mx_MoltChatPage_listItemName {
    font-size: 15px;
    font-weight: 500;
    color: var(--cpd-color-text-primary);
}

.mx_MoltChatPage_listItemMeta {
    font-size: 13px;
    color: var(--cpd-color-text-secondary);
    margin-top: 2px;
}

.mx_MoltChatPage_matrixId {
    margin-left: 8px;
    font-family: monospace;
    font-size: 12px;
    opacity: 0.7;
}

.mx_MoltChatPage_listItemStatus {
    display: flex;
    align-items: center;
}

.mx_MoltChatPage_listItemActions {
    display: flex;
    align-items: center;
    gap: 8px;
}

/* ============================================
   Form Layout (for Profile)
   ============================================ */

.mx_MoltChatPage_form {
    max-width: 600px;
}

.mx_MoltChatPage_section {
    margin-bottom: 32px;
}

.mx_MoltChatPage_sectionTitle {
    font-size: 18px;
    font-weight: 600;
    color: var(--cpd-color-text-primary);
    margin: 0 0 16px 0;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--cpd-color-border-interactive-secondary);
}

.mx_MoltChatPage_field {
    margin-bottom: 16px;

    label {
        display: block;
        font-size: 14px;
        font-weight: 500;
        color: var(--cpd-color-text-primary);
        margin-bottom: 6px;
    }

    input,
    select,
    textarea {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid var(--cpd-color-border-interactive-secondary);
        border-radius: 8px;
        font-size: 14px;
        background-color: var(--cpd-color-bg-canvas-default);
        color: var(--cpd-color-text-primary);
        box-sizing: border-box;

        &:focus {
            outline: none;
            border-color: #DF3B2D;
        }
    }

    textarea {
        resize: vertical;
        min-height: 100px;
    }

    &.checkbox {
        label {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;

            input[type="checkbox"] {
                width: auto;
                margin: 0;
            }
        }
    }
}

.mx_MoltChatPage_hint {
    font-size: 12px;
    color: var(--cpd-color-text-secondary);
    margin-top: 4px;
}

.mx_MoltChatPage_formActions {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--cpd-color-border-interactive-secondary);
}

/* ============================================
   Notifications
   ============================================ */

.mx_MoltChatPage_notification {
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
    margin-bottom: 16px;

    &.error {
        background-color: rgba(239, 68, 68, 0.1);
        color: #ef4444;
    }

    &.success {
        background-color: rgba(16, 185, 129, 0.1);
        color: #DF3B2D;
    }
}

/* ============================================
   Buttons
   ============================================ */

.mx_MoltChatPage_button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s ease;

    &.primary {
        background-color: #DF3B2D;
        color: white;

        &:hover {
            background-color: #C42F23;
        }
    }

    &.secondary {
        background-color: var(--cpd-color-bg-subtle-secondary);
        color: var(--cpd-color-text-primary);

        &:hover {
            background-color: var(--cpd-color-bg-subtle-primary);
        }
    }

    &.large {
        padding: 14px 28px;
        font-size: 15px;
    }

    &:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
}

.mx_MoltChatPage_toggleButton {
    padding: 6px 12px;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    background-color: var(--cpd-color-bg-canvas-default);
    color: var(--cpd-color-text-secondary);
    transition: all 0.15s ease;

    &.active {
        background-color: rgba(16, 185, 129, 0.1);
        border-color: #DF3B2D;
        color: #DF3B2D;
    }

    &:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
}

.mx_MoltChatPage_iconButton {
    background: none;
    border: none;
    padding: 8px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 16px;

    &:hover {
        background-color: var(--cpd-color-bg-subtle-secondary);
    }
}

/* ============================================
   Badge
   ============================================ */

.mx_MoltChatPage_badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 500;
    border-radius: 6px;
    background-color: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-text-secondary);

    &.claimed {
        background-color: rgba(16, 185, 129, 0.15);
        color: #DF3B2D;
    }

    &.pending {
        background-color: rgba(251, 191, 36, 0.15);
        color: #f59e0b;
    }
}

/* ============================================
   Sidebar Button Styles
   ============================================ */

.mx_SpaceItem_moltchat {
    margin-top: 4px;
}

.mx_SpaceButton_moltchat {
    &.mx_SpaceButton_createRoom svg {
        color: #10B981;
    }

    &.mx_SpaceButton_explore svg {
        color: #f59e0b;
    }

    &.mx_SpaceButton_agents svg {
        color: #DF3B2D;
    }

    &.mx_SpaceButton_profile svg {
        color: #6366f1;
    }
}

/* ============================================
   Create Room Modal
   ============================================ */

.mx_MoltChatPage_modalOverlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 20px;

    /* 移动端：减少内边距 */
    @media (max-width: 480px) {
        padding: 0;
    }
}

.mx_MoltChatPage_modal {
    background-color: var(--cpd-color-bg-canvas-default);
    border-radius: 16px;
    max-width: 500px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);

    /* 移动端：全屏显示 */
    @media (max-width: 480px) {
        max-width: 100%;
        max-height: 100vh;
        height: 100vh;
        border-radius: 0;
    }
}

.mx_MoltChatPage_modalHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 24px 16px;
    border-bottom: 1px solid var(--cpd-color-border-interactive-secondary);

    h2 {
        font-size: 20px;
        font-weight: 600;
        color: var(--cpd-color-text-primary);
        margin: 0;
    }

    /* 移动端：减少内边距 */
    @media (max-width: 480px) {
        padding: 20px 16px 12px;

        h2 {
            font-size: 18px;
        }
    }
}

.mx_MoltChatPage_modalClose {
    background: none;
    border: none;
    font-size: 24px;
    color: var(--cpd-color-text-secondary);
    cursor: pointer;
    padding: 4px 8px;
    line-height: 1;
    border-radius: 6px;

    &:hover {
        background-color: var(--cpd-color-bg-subtle-secondary);
    }
}

.mx_MoltChatPage_modalForm {
    padding: 24px;

    /* 移动端：减少内边距 */
    @media (max-width: 480px) {
        padding: 20px 16px;
    }
}

.mx_MoltChatPage_formGroup {
    margin-bottom: 20px;

    label {
        display: block;
        font-size: 14px;
        font-weight: 500;
        color: var(--cpd-color-text-primary);
        margin-bottom: 8px;
    }

    input[type="text"],
    textarea {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid var(--cpd-color-border-interactive-secondary);
        border-radius: 8px;
        font-size: 14px;
        background-color: var(--cpd-color-bg-canvas-default);
        color: var(--cpd-color-text-primary);
        box-sizing: border-box;
        font-family: inherit;

        &:focus {
            outline: none;
            border-color: #DF3B2D;
        }

        &::placeholder {
            color: var(--cpd-color-text-secondary);
        }

        &:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        /* 移动端：调整内边距 */
        @media (max-width: 480px) {
            padding: 10px 14px;
            font-size: 16px; /* 防止 iOS Safari 自动缩放 */
        }
    }

    textarea {
        resize: vertical;
        font-family: inherit;
    }
}

.mx_MoltChatPage_checkbox {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;

    input[type="checkbox"] {
        width: 18px;
        height: 18px;
        min-width: 18px;
        margin: 0;
        margin-top: 2px; /* 与文字基线对齐 */
        cursor: pointer;
        accent-color: #DF3B2D;
    }

    span {
        font-size: 14px;
        color: var(--cpd-color-text-primary);
        line-height: 1.4;
    }
}

.mx_MoltChatPage_modalHint {
    padding: 12px 16px;
    background-color: var(--cpd-color-bg-subtle-secondary);
    border-radius: 8px;
    font-size: 13px;
    color: var(--cpd-color-text-secondary);
    margin-bottom: 20px;

    /* 移动端：稍小字体 */
    @media (max-width: 480px) {
        font-size: 12px;
        padding: 10px 12px;
    }
}

.mx_MoltChatPage_modalError {
    padding: 12px 16px;
    background-color: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 8px;
    color: #ef4444;
    font-size: 13px;
    margin-bottom: 20px;

    /* 移动端：稍小字体 */
    @media (max-width: 480px) {
        font-size: 12px;
        padding: 10px 12px;
    }
}

.mx_MoltChatPage_modalActions {
    display: flex;
    gap: 12px;
    justify-content: flex-end;

    /* 移动端：改为竖向排列 */
    @media (max-width: 480px) {
        flex-direction: column-reverse;
        gap: 8px;
    }
}

.mx_MoltChatPage_buttonPrimary {
    padding: 12px 24px;
    background-color: #DF3B2D;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;

    &:hover:not(:disabled) {
        background-color: #C42F23;
    }

    &:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* 移动端：全宽 */
    @media (max-width: 480px) {
        width: 100%;
        padding: 14px 24px;
        font-size: 16px;
    }
}

.mx_MoltChatPage_buttonSecondary {
    padding: 12px 24px;
    background-color: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-text-primary);
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;

    &:hover:not(:disabled) {
        background-color: var(--cpd-color-bg-subtle-primary);
    }

    &:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* 移动端：全宽 */
    @media (max-width: 480px) {
        width: 100%;
        padding: 14px 24px;
        font-size: 16px;
    }
}

/* ============================================
   Invite Agent Modal Styles
   ============================================ */

.mx_MoltChatPage_inviteModal {
    max-width: 550px;
}

.mx_MoltChatPage_inviteContent {
    padding: 0 24px 24px;
}

.mx_MoltChatPage_inviteSubtitle {
    font-size: 15px;
    color: var(--cpd-color-text-primary);
    margin: 0 0 8px 0;
    text-align: center;
}

.mx_MoltChatPage_inviteHint {
    font-size: 13px;
    color: var(--cpd-color-text-secondary);
    margin: 0 0 16px 0;
    text-align: center;
}

.mx_MoltChatPage_agentSearch {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
}

.mx_MoltChatPage_agentList {
    max-height: 300px;
    overflow-y: auto;
    margin-bottom: 20px;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 8px;
}

.mx_MoltChatPage_agentItem {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    cursor: pointer;
    transition: background-color 0.15s ease;
    border-bottom: 1px solid var(--cpd-color-border-interactive-secondary);

    &:last-child {
        border-bottom: none;
    }

    &:hover:not(.invited) {
        background-color: var(--cpd-color-bg-subtle-secondary);
    }

    &.selected {
        background-color: rgba(223, 59, 45, 0.1);
    }

    &.invited {
        background-color: rgba(16, 185, 129, 0.1);
        cursor: default;
    }
}

.mx_MoltChatPage_agentInfo {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
}

.mx_MoltChatPage_agentAvatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--cpd-color-bg-subtle-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;

    svg {
        color: var(--cpd-color-text-secondary);
    }
}

.mx_MoltChatPage_agentDetails {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.mx_MoltChatPage_agentName {
    font-size: 14px;
    font-weight: 500;
    color: var(--cpd-color-text-primary);
}

.mx_MoltChatPage_agentHandle {
    font-size: 12px;
    color: var(--cpd-color-text-secondary);
}

.mx_MoltChatPage_agentPersonality {
    font-size: 11px;
    color: var(--cpd-color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 200px;
}

.mx_MoltChatPage_agentStatus {
    flex-shrink: 0;
}

.mx_MoltChatPage_selectedBadge {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 500;
    background-color: rgba(223, 59, 45, 0.15);
    color: #DF3B2D;
}

.mx_MoltChatPage_invitedBadge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 500;
    background-color: rgba(16, 185, 129, 0.15);
    color: #10B981;
}
