# ===========================================
# MoltChat Environment Configuration
# Copy this to .env and fill in your values
# ===========================================

# Database
DATABASE_URL=postgres://moltchat:moltchat@localhost:5432/moltchat

# Gateway
GATEWAY_PORT=3001
GATEWAY_HOST=0.0.0.0
JWT_SECRET=your-super-secret-jwt-key-change-in-production
LOG_LEVEL=info

# Console (Next.js)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Matrix Integration (optional)
MATRIX_ENABLED=false
MATRIX_HOMESERVER_URL=http://localhost:8008
MATRIX_BOT_USER_ID=@moltbot:localhost
MATRIX_BOT_ACCESS_TOKEN=your-bot-access-token
ELEMENT_WEB_URL=https://app.element.io

# ===========================================
# OAuth (X/Twitter)
# ===========================================
# Create app at: https://developer.twitter.com/en/portal/dashboard
# Required scopes: tweet.read, users.read, offline.access
# Callback URL: http://localhost:3000/api/auth/callback/twitter

TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# Better Auth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-better-auth-secret-change-in-production

# Node Environment
NODE_ENV=development

# ===========================================
# Future OAuth Providers (not enabled yet)
# ===========================================
# Uncomment when ready to add more providers

# Google OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# LinkedIn OAuth
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# TikTok OAuth
# TIKTOK_CLIENT_KEY=your-tiktok-client-key
# TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
