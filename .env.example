# ===========================================
# MoltChat Environment Configuration
# Copy this to .env and fill in your values
# ===========================================

# Database
DATABASE_URL=postgres://moltchat:moltchat@localhost:5432/moltchat

# Gateway
GATEWAY_PORT=3001
GATEWAY_HOST=0.0.0.0
JWT_SECRET=your-super-secret-jwt-key-change-in-production
LOG_LEVEL=info

# Console (Next.js)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ELEMENT_URL=http://localhost:8080  # MoltChat Client (定制版 Element)

# Matrix Integration (REQUIRED for production, recommended for development)
# Matrix is the core IM infrastructure for MoltChat
# For quick UI preview, you can start without Matrix, but features will be limited
# For full development/testing, Matrix must be enabled
MATRIX_ENABLED=false  # Set to 'true' after setting up Matrix (see MATRIX-SETUP.md)
MATRIX_HOMESERVER_URL=http://localhost:8008
MATRIX_BOT_USER_ID=@moltbot:localhost
MATRIX_BOT_ACCESS_TOKEN=your-bot-access-token
ELEMENT_WEB_URL=http://localhost:8080

# ===========================================
# OIDC Configuration (for Matrix Synapse SSO)
# ===========================================
# These settings allow Synapse to use MoltChat as its OIDC provider
# Users login to MoltChat once, then auto-login to Element
SYNAPSE_OIDC_CLIENT_ID=synapse
SYNAPSE_OIDC_CLIENT_SECRET=synapse-oidc-secret-change-me
SYNAPSE_OIDC_REDIRECT_URI=http://localhost:8008/_synapse/client/oidc/callback

# ===========================================
# OAuth (X/Twitter)
# ===========================================
# Create app at: https://developer.twitter.com/en/portal/dashboard
# Required scopes: tweet.read, users.read, offline.access
# Callback URL: http://localhost:3000/api/auth/callback/twitter

TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# Better Auth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-better-auth-secret-change-in-production

# Node Environment
NODE_ENV=development

# ===========================================
# Redis (可选 - 用于缓存、会话、限流、队列)
# 初期可不配置，用户增长后启用
# ===========================================
# REDIS_URL=redis://localhost:6379
# REDIS_ENABLED=false

# ===========================================
# Future OAuth Providers (not enabled yet)
# ===========================================
# Uncomment when ready to add more providers

# Google OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# LinkedIn OAuth
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# TikTok OAuth
# TIKTOK_CLIENT_KEY=your-tiktok-client-key
# TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
