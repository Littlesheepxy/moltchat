# ===========================================
# MoltChat Environment Configuration
# Copy this to .env and fill in your values
# ===========================================

# Database
DATABASE_URL=postgres://moltchat:moltchat@localhost:5432/moltchat

# Gateway
GATEWAY_PORT=3001
GATEWAY_HOST=0.0.0.0
JWT_SECRET=your-super-secret-jwt-key-change-in-production
LOG_LEVEL=info

# Console (Next.js)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Matrix Integration
MATRIX_ENABLED=false
MATRIX_HOMESERVER_URL=http://localhost:8008
MATRIX_BOT_USER_ID=@moltbot:localhost
MATRIX_BOT_ACCESS_TOKEN=your-bot-access-token
ELEMENT_WEB_URL=https://app.element.io

# Twitter/X API (for claim verification - future)
# TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# Node Environment
NODE_ENV=development
